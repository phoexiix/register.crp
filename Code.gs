const CRP=Object.freeze({applications:'Applications',audit:'AuditLog',sessionSeconds:21600,statuses:['รอตรวจสอบ','อยู่ระหว่างพิจารณา','ผ่านการคัดเลือก','ไม่ผ่านการคัดเลือก']});
const HEADERS=['ApplicationID','CreatedAt','Prefix','FirstName','LastName','BirthDate','Phone','Email','Province','Education','Motivation','Status','AdminNote','UpdatedAt'];
const AUDIT_HEADERS=['At','Actor','Action','ApplicationID','Details'];
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('สร้าง Apps Script จาก Extensions > Apps Script ของ Google Sheet');ensureSheet_(ss,CRP.applications,HEADERS);ensureSheet_(ss,CRP.audit,AUDIT_HEADERS);const p=PropertiesService.getScriptProperties();if(!p.getProperty('ADMIN_HASH'))throw Error('โปรดตั้งชื่อผู้ใช้และรหัสผ่านใน changeAdminCredentials() แล้วรันฟังก์ชันนั้น');return 'CRP พร้อมใช้งาน';}
function changeAdminCredentials(){setAdminCredentials_('CHANGE_USERNAME','CHANGE_STRONG_PASSWORD');return 'อัปเดตบัญชีสำเร็จ';}
function setAdminCredentials_(username,password){if(!username||!password||username==='CHANGE_USERNAME'||password==='CHANGE_STRONG_PASSWORD')throw Error('กรุณากำหนดชื่อผู้ใช้และรหัสผ่านใหม่ก่อน');const salt=Utilities.getUuid()+Utilities.getUuid();PropertiesService.getScriptProperties().setProperties({ADMIN_USER:String(username),ADMIN_SALT:salt,ADMIN_HASH:sha256_(salt+':'+password)});}
function doGet(e){const page=String(e&&e.parameter&&e.parameter.page||'').toLowerCase()==='admin'?'admin':'index';const t=HtmlService.createTemplateFromFile(page);t.appUrl=ScriptApp.getService().getUrl()||'';return t.evaluate().setTitle(page==='admin'?'CRP | เจ้าหน้าที่':'CRP | ตรวจสอบผู้สมัคร').addMetaTag('viewport','width=device-width, initial-scale=1');}
function apiRequest(action,payload){const p=payload&&typeof payload==='object'&&!Array.isArray(payload)?payload:{};switch(String(action)){case 'ping':return {message:'CRP Backend Online',now:new Date().toISOString()};case 'publicSearch':return publicSearch_(p);case 'publicDetails':return publicDetails_(p);case 'login':return login_(p);case 'logout':return logout_(p);case 'getApplications':return getApplications_(p);case 'getApplication':return getApplication_(p);case 'addApplication':return addApplication_(p);case 'updateApplication':return updateApplication_(p);case 'setApplicationStatus':return setApplicationStatus_(p);case 'getSummary':return getSummary_(p);default:throw Error('ไม่รองรับคำสั่งนี้');}}
function login_(p){const props=PropertiesService.getScriptProperties(),username=clean_(p.username,100),password=String(p.password||''),cache=CacheService.getScriptCache();const key='CRP_LOGIN_FAILURES_'+sha256_(username).slice(0,24),failures=Number(cache.get(key)||0);if(failures>=10)throw Error('ลองเข้าสู่ระบบมากเกินไป กรุณาลองใหม่ภายหลัง');const expected=props.getProperty('ADMIN_HASH');if(!expected)throw Error('กรุณาตั้งค่าบัญชีเจ้าหน้าที่ก่อน');const actual=sha256_(String(props.getProperty('ADMIN_SALT')||'')+':'+password);if(username!==props.getProperty('ADMIN_USER')||actual!==expected){cache.put(key,String(failures+1),300);throw Error('ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง');}cache.remove(key);const token=Utilities.getUuid()+Utilities.getUuid();cache.put('CRP_SESSION_'+sha256_(token),username,CRP.sessionSeconds);log_('login','',username,'');return {token,username,expiresIn:CRP.sessionSeconds};}
function requireAdmin_(p){const token=String(p.token||'');if(!/^[0-9a-f-]{72}$/i.test(token))throw Error('กรุณาเข้าสู่ระบบเจ้าหน้าที่');const user=CacheService.getScriptCache().get('CRP_SESSION_'+sha256_(token));if(!user)throw Error('เซสชันหมดอายุ กรุณาเข้าสู่ระบบใหม่');return user;}
function logout_(p){const token=String(p.token||'');if(token)CacheService.getScriptCache().remove('CRP_SESSION_'+sha256_(token));return {success:true};}
function publicSearch_(p){const query=normalize_(clean_(p.query,120));if(!query)return {total:0,items:[]};const matching=allRows_().map(publicView_).filter(x=>normalize_(x.applicationId+' '+x.fullName).includes(query));return {total:matching.length,items:matching.slice(0,100)};}
function publicDetails_(p){const id=clean_(p.applicationId,50),r=allRows_().find(x=>x.ApplicationID===id);if(!r)throw Error('ไม่พบข้อมูลผู้สมัคร');return publicView_(r);}
function publicView_(r){return {applicationId:r.ApplicationID,fullName:[r.Prefix,r.FirstName,r.LastName].filter(Boolean).join(' '),province:r.Province,education:r.Education,registeredAt:r.CreatedAt,registration:'ลงทะเบียนสำเร็จ',status:r.Status};}
function getApplications_(p){requireAdmin_(p);const query=normalize_(clean_(p.query,120)),status=clean_(p.status,50);const rows=allRows_().filter(r=>(!status||r.Status===status)&&(!query||normalize_(r.ApplicationID+' '+r.Prefix+' '+r.FirstName+' '+r.LastName).includes(query)));return {total:rows.length,items:rows.slice(0,500)};}
function getApplication_(p){requireAdmin_(p);const r=allRows_().find(x=>x.ApplicationID===clean_(p.applicationId,50));if(!r)throw Error('ไม่พบข้อมูลผู้สมัคร');return r;}
function addApplication_(p){const admin=requireAdmin_(p),input=validateInput_(p.application||{}),lock=LockService.getScriptLock();lock.waitLock(20000);try{const sh=sheet_(),id='CRP-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd')+'-'+Utilities.getUuid().slice(0,8).toUpperCase(),now=new Date().toISOString(),record={ApplicationID:id,CreatedAt:now,...input,Status:CRP.statuses[0],AdminNote:'',UpdatedAt:now};sh.appendRow(HEADERS.map(k=>safeCell_(record[k])));log_('add',id,admin,'');return {success:true,applicationId:id,record};}finally{lock.releaseLock();}}
function updateApplication_(p){const admin=requireAdmin_(p),id=clean_(p.applicationId,50),input=validateInput_(p.application||{}),lock=LockService.getScriptLock();lock.waitLock(20000);try{const m=findRow_(id);if(!m)throw Error('ไม่พบข้อมูลผู้สมัคร');const record={...m.record,...input,UpdatedAt:new Date().toISOString()};m.sh.getRange(m.index,1,1,HEADERS.length).setValues([HEADERS.map(k=>safeCell_(record[k]))]);log_('update',id,admin,'');return {success:true,applicationId:id,record};}finally{lock.releaseLock();}}
function setApplicationStatus_(p){const admin=requireAdmin_(p),id=clean_(p.applicationId,50),status=clean_(p.status,50);if(!CRP.statuses.includes(status))throw Error('สถานะไม่ถูกต้อง');const note=clean_(p.note,2000),lock=LockService.getScriptLock();lock.waitLock(20000);try{const m=findRow_(id);if(!m)throw Error('ไม่พบข้อมูลผู้สมัคร');const r={...m.record,Status:status,AdminNote:note,UpdatedAt:new Date().toISOString()};m.sh.getRange(m.index,1,1,HEADERS.length).setValues([HEADERS.map(k=>safeCell_(r[k]))]);log_('status',id,admin,status);return {success:true,applicationId:id,status};}finally{lock.releaseLock();}}
function getSummary_(p){requireAdmin_(p);const rows=allRows_(),byStatus=Object.fromEntries(CRP.statuses.map(s=>[s,0])),byProvince={};rows.forEach(r=>{if(Object.prototype.hasOwnProperty.call(byStatus,r.Status))byStatus[r.Status]++;const k=r.Province||'ไม่ระบุ';byProvince[k]=(byProvince[k]||0)+1;});return {total:rows.length,byStatus,byProvince,latest:rows.slice(0,10).map(r=>({applicationId:r.ApplicationID,fullName:[r.Prefix,r.FirstName,r.LastName].filter(Boolean).join(' '),status:r.Status,createdAt:r.CreatedAt}))};}
function validateInput_(obj){const r={Prefix:clean_(obj.prefix,30),FirstName:clean_(obj.firstName,100),LastName:clean_(obj.lastName,100),BirthDate:clean_(obj.birthDate,30),Phone:clean_(obj.phone,30),Email:clean_(obj.email,150),Province:clean_(obj.province,100),Education:clean_(obj.education,100),Motivation:clean_(obj.motivation,3000)};if(!r.FirstName||!r.LastName)throw Error('กรุณาระบุชื่อและนามสกุล');if(r.Phone&&!/^[0-9+()\-\s]{8,20}$/.test(r.Phone))throw Error('เบอร์โทรศัพท์ไม่ถูกต้อง');if(r.Email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(r.Email))throw Error('อีเมลไม่ถูกต้อง');if(r.BirthDate&&!/^\d{4}-\d{2}-\d{2}$/.test(r.BirthDate))throw Error('วันเกิดต้องเป็น YYYY-MM-DD');return r;}
function sheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('ไม่พบ Google Sheet ที่ผูกกับสคริปต์');const sh=ss.getSheetByName(CRP.applications);if(!sh)throw Error('กรุณารัน setup() ก่อน');return sh;}
function allRows_(){const sh=sheet_(),last=sh.getLastRow();if(last<2)return [];return sh.getRange(2,1,last-1,HEADERS.length).getDisplayValues().filter(row=>row[0]).map(row=>Object.fromEntries(HEADERS.map((k,i)=>[k,row[i]]))).reverse();}
function findRow_(id){const sh=sheet_(),last=sh.getLastRow();if(last<2)return null;const ids=sh.getRange(2,1,last-1,1).getDisplayValues().flat(),ix=ids.indexOf(id);if(ix<0)return null;const row=sh.getRange(ix+2,1,1,HEADERS.length).getDisplayValues()[0];return {sh,index:ix+2,record:Object.fromEntries(HEADERS.map((k,i)=>[k,row[i]]))};}
function ensureSheet_(ss,name,headers){const sh=ss.getSheetByName(name)||ss.insertSheet(name);if(sh.getMaxColumns()<headers.length)sh.insertColumnsAfter(sh.getMaxColumns(),headers.length-sh.getMaxColumns());if(sh.getLastRow()===0)sh.appendRow(headers);else if(sh.getRange(1,1,1,headers.length).getDisplayValues()[0].join('|')!==headers.join('|'))throw Error('หัวตาราง '+name+' ไม่ตรงกับระบบ');sh.setFrozenRows(1);sh.getRange(1,1,1,headers.length).setFontWeight('bold').setBackground('#eaf5ff');return sh;}
function log_(action,id,actor,details){const ss=SpreadsheetApp.getActiveSpreadsheet(),sh=ss.getSheetByName(CRP.audit);if(sh)sh.appendRow([new Date().toISOString(),safeCell_(actor),safeCell_(action),safeCell_(id),safeCell_(details)]);}
function clean_(v,max){return String(v==null?'':v).trim().slice(0,max);}
function normalize_(v){return String(v||'').toLocaleLowerCase().replace(/\s+/g,' ').trim();}
function safeCell_(v){const s=String(v==null?'':v);return /^[=+\-@\t\r]/.test(s)?"'"+s:s;}
function sha256_(s){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,s,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('');}
